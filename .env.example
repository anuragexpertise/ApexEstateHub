# EstateHub — environment manifest (Render + Aiven PostgreSQL).
# Copy to .env for local use. On Render set these in the dashboard / an env group.
# Never commit real values.

# ── Core ────────────────────────────────────────────────────────────────
FLASK_CONFIG=production            # development | production | testing
FLASK_DEBUG=false                  # never true in production (enables the Werkzeug debugger)
PORT=8050                          # Render injects PORT
SECRET_KEY=                        # Flask session signing key (render.yaml: generateValue)
JWT_SECRET_KEY=                    # JWT signing key (render.yaml: generateValue)
SECRET_VAULT_KEY=                  # wraps per-society signing keys; must match the seeded DB
FRONTEND_URL=https://your-app.onrender.com   # used in reset/email links; https only

# ── Database (Aiven PostgreSQL) ─────────────────────────────────────────
# DATABASE_URL wins over PG* in both the web app and the CLI scripts.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Alternative to DATABASE_URL:
# PGHOST= PGPORT= PGDATABASE= PGUSER= PGPASSWORD=
PGSSLMODE=require                  # use verify-full with the Aiven CA for stronger checks
# PGSSLROOTCERT=/path/to/aiven-ca.pem   # CA is downloadable from the Aiven console; do not commit it
DB_POOL_MIN=2
DB_POOL_MAX=10                     # worst case connections = gunicorn workers x DB_POOL_MAX
                                   # (Procfile: 2 workers = 20). Keep below your Aiven plan's
                                   # connection limit, leaving headroom for cron jobs and psql.
DB_POOL_WAIT=20
# PG_SKIP_STARTUP_OPTIONS=1        # only if connecting through Aiven's PgBouncer pooler

# ── Web Push (VAPID) ────────────────────────────────────────────────────
VAPID_PUBLIC=                      # base64url public key (also served to the browser)
VAPID_PRIVATE=                     # base64url private key — server only, never in client code
VAPID_EMAIL=you@yourdomain.com     # used as the mailto: claim; use a real address you control
WEBPUSH_CONNECT_TIMEOUT=3          # seconds
WEBPUSH_READ_TIMEOUT=8             # seconds
# FCM_SERVER_KEY=                  # optional, native mobile push

# ── Reverse proxy / CORS ────────────────────────────────────────────────
TRUSTED_PROXY_HOPS=1               # Render = 1 proxy hop; 0 disables ProxyFix
CORS_ORIGINS=                      # comma-separated origins; empty = no cross-origin access

# ── Realtime (SSE) ──────────────────────────────────────────────────────
SSE_MAX_PER_USER=2
SSE_MAX_PER_WORKER=5               # each stream pins a gunicorn thread (Procfile: 8 per worker)
# REDIS_URL=                       # optional; lets SSE/push fan out across workers

# ── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ── Integrations / operator ─────────────────────────────────────────────
# ESIGN_CALLBACK_SECRET=           # HMAC secret for the eSign callback
# OPERATOR_LEGAL_NAME=
# OPERATOR_ADDRESS=
# PLAN_GRACE_DAYS=
# ESTATEHUB_FAIL_CLOSED=1          # crash at boot if the DB is unreachable (instead of degraded mode)
