diff --git a/database/estatehub.sql b/database/estatehub.sql
index 24cb112..3fe8488 100644
--- a/database/estatehub.sql
+++ b/database/estatehub.sql
@@ -279,6 +279,107 @@ CREATE INDEX IF NOT EXISTS idx_concerns_assigns_concern ON concerns_assigns (con
